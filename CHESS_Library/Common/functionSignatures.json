{
  "_schemaVersion": "1.0.0",
  "chess_units": {
    "inputs": [
      {"name": "unit_kind", "kind": "ordered", "type": ["char", "choices={'length','mass','density','force','pressure','time','angle','velocity','discharge_per_length','volume_per_length','force_per_length','dimensionless','system'}"]},
      {"name": "system_name", "kind": "ordered", "type": ["char", "choices={'SI','Imperial'}"]}
    ],
    "outputs": [
      {"name": "out", "type": [["char"], ["struct"]]}
    ]
  },
  "discrete_standard_normal_scores": {
    "inputs": [
      {"name": "storm_type", "kind": "required", "type": ["char", "choices={'XC','TC'}"]}
    ],
    "outputs": [
      {"name": "z_scores", "type": ["double"]}
    ]
  },
  "lcs_columns": {
    "inputs": [
      {"name": "data_type", "kind": "ordered", "type": ["char", "choices={'Peaks','Timeseries'}"]}
    ],
    "outputs": [
      {"name": "C", "type": ["struct"]}
    ]
  },
  "storm_types_for_sampling": {
    "inputs": [
      {"name": "storm_sampling", "kind": "required", "type": ["char", "choices={'XC','TC','CC'}"]},
      {"name": "order", "kind": "required", "type": ["cell"]}
    ],
    "outputs": [
      {"name": "storm_types", "type": ["cell"]}
    ]
  }
}
